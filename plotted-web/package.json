{
  "name": "plotted-web",
  "version": "0.1.0",
  "private": true,
  "//engines": "npm 10.1 hoists Angular's conflicting chokidar ranges into a tree that `npm ci` then rejects, so a lock generated by an older npm than CI's breaks the build. Declared to make that mismatch a warning instead of a CI failure.",
  "engines": {
    "node": "^20.11.1 || ^22.0.0",
    "npm": ">=10.8.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "generate:api": "openapi-generator-cli generate -i ../openapi/openapi.json -g typescript-angular -o src/app/core/api --additional-properties=ngVersion=18.2.0,providedInRoot=true,withInterfaces=true,fileNaming=kebab-case",
    "verify:api": "node scripts/verify-api-client.mjs"
  },
  "//rollup": "npm prunes non-matching platform binaries out of the lockfile's package list, so a lock generated on Windows leaves Linux with no entry to install and rollup fails at runtime (npm/cli#4828). These are declared explicitly so every platform the project builds on is in the lock: gnu for CI, musl for the Alpine image, msvc for local development. rollup requires its binary to match its own version exactly, hence the override pinning rollup itself.",
  "overrides": {
    "rollup": "4.22.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.22.4",
    "@rollup/rollup-linux-x64-musl": "4.22.4",
    "@rollup/rollup-win32-x64-msvc": "4.22.4"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@openapitools/openapi-generator-cli": "2.15.3",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
