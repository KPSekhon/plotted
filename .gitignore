# --- Build output ---
build/
.kotlin/

# JVM crash reports. OR-Tools is a JNI binding and a bad native environment
# leaves these behind; they are diagnostics, not source.
hs_err_pid*.log
replay_pid*.log
out/
dist/
bin/
*.jar
!gradle/wrapper/gradle-wrapper.jar

# --- Gradle ---
.gradle/
!gradle/wrapper/gradle-wrapper.properties

# --- Node ---
node_modules/
npm-debug.log*
.angular/

# --- IDE ---
.idea/
*.iml
.vscode/
!.vscode/extensions.json
*.swp

# --- OS ---
.DS_Store
Thumbs.db

# --- Secrets and local configuration ---
# Nothing here is ever committed. Secrets come from the environment locally and
# from Google Secret Manager in production (spec section 18).
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Data ---
# Availability snapshots are the project's own dataset and are backed up
# separately, but bulk availability data must never be redistributed through this
# repository (spec section 7.4).
data/snapshots/
*.dump
*.sql.gz

# The Python training toolchain (phase 8). The model it produces is committed;
# the several hundred megabytes of wheels that produced it are not. Listed on
# every branch, not just the one that introduced it: a working tree carries the
# venv across checkouts, so a branch without this rule will happily stage 18,000
# files the moment somebody runs `git add -A`.
.venv-ml/
