# Copy to .env for local overrides. .env is git-ignored and must stay that way.
#
# The development defaults in application.yml are enough to run `make dev`; this
# file exists for the values you will need from phase 2 onwards.

# --- Database ---
PLOTTED_DB_URL=jdbc:postgresql://localhost:5432/plotted
PLOTTED_DB_USER=plotted
PLOTTED_DB_PASSWORD=plotted

# --- Redis ---
# Declared, and not yet used by anything: it is here for the phase 11 rate
# limiter. A deployment does not need a Redis instance, and application-prod.yml
# disables its health contributor so an absent one cannot fail the readiness
# probe for a component with no callers.
PLOTTED_REDIS_HOST=localhost
PLOTTED_REDIS_PORT=6379

# --- Security ---
# Base64, at least 32 bytes decoded. Generate one with:
#   openssl rand -base64 48
# The application refuses to start with the development default outside the dev
# profile, so this must be set in staging and production.
PLOTTED_JWT_SECRET=

# --- TMDB (phase 2) ---
# Register at https://www.themoviedb.org/settings/api. Attribution is required
# wherever the data is displayed; see docs/data-sources.md.
#
# TMDB_READ_ACCESS_TOKEN is the one that matters: it is what the application
# reads. TMDB_API_KEY is unused by the code and kept for tooling.
#
# WORTH KNOWING: an empty token does not fail loudly. The application boots
# perfectly happily, serves empty screens, and only says "TMDB is not configured"
# when something asks it to seed or refresh availability -- which, on a machine
# with no database, is never. It sat empty here through the whole of development
# and nothing noticed. `make check-env` is what catches it now; run that before
# deploying rather than finding out from a log afterwards.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# --- Catalogue jobs (phase 2) ---
# One-shot ingestion of seed/canadian-seed.txt on startup, after which the
# application carries on normally. Idempotent, so it is also how the seed gets
# re-pulled after a schema change. Equivalent to `make seed`.
PLOTTED_SEED_ENABLED=false

# Nightly availability snapshots, 03:30. False here because a developer machine
# should not quietly spend the TMDB quota, but it must be true wherever the
# history is actually collected: Plot Armour (phase 10) needs months of
# snapshots before it can exist at all, and a night not collected cannot be
# recovered afterwards. Turn this on in the first environment that runs
# continuously, which is the earliest the clock can start.
PLOTTED_SNAPSHOT_ENABLED=false

# --- Demo mode (phase 6) ---
# A signed-in Plotted with no signup: POST /api/v1/demo/session creates a
# throwaway account with a watchlist and subscriptions built from the seeded
# catalogue, and returns a normal session for it.
#
# FALSE HERE ON PURPOSE. The endpoint is unauthenticated and it writes rows, so
# the default has to be the safe answer. Set it true on the deployment that is
# meant to be a demo and nowhere else. Accounts expire after 24 hours and an
# hourly job sweeps them; the endpoint refuses past a ceiling rather than letting
# a script fill a free-tier database.
PLOTTED_DEMO_ENABLED=false

# --- Availability verification (phase 2 seed work) ---
# Watchmode answers "which service actually carries this title", which is what
# turns the seed list from asserted into verified.
#
# HARD QUOTA: 2500 requests per MONTH. Not a rate limit -- a monthly allowance
# with no way to buy more. One request per seed title is 5% of the month, so
# cache every response and never call this from a test or a CI job.
WATCHMODE_API_KEY=

# MDBList: ratings, votes and a second opinion on availability.
# HARD QUOTA: 1000 requests per DAY.
MDBLIST_API_KEY=
