# Copy to .env for local overrides. .env is git-ignored and must stay that way.
#
# The development defaults in application.yml are enough to run `make dev`; this
# file exists for the values you will need from phase 2 onwards.

# --- Database ---
PLOTTED_DB_URL=jdbc:postgresql://localhost:5432/plotted
PLOTTED_DB_USER=plotted
PLOTTED_DB_PASSWORD=plotted

# --- Redis ---
PLOTTED_REDIS_HOST=localhost
PLOTTED_REDIS_PORT=6379

# --- Security ---
# Base64, at least 32 bytes decoded. Generate one with:
#   openssl rand -base64 48
# The application refuses to start with the development default outside the dev
# profile, so this must be set in staging and production.
PLOTTED_JWT_SECRET=

# --- TMDB (phase 2) ---
# Register at https://www.themoviedb.org/settings/api. Attribution is required
# wherever the data is displayed; see docs/data-sources.md.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
