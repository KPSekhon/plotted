{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Plotted API",
    "description" : "Platform-neutral streaming decision and subscription optimisation platform. Title metadata and regional availability originate from TMDB and JustWatch; see /legal/data-sources for attribution and refresh cadence.",
    "license" : {
      "name" : "AGPL-3.0-or-later"
    },
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "This deployment"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/api/v1/watchlist/items" : {
      "post" : {
        "tags" : [ "watchlist-controller" ],
        "summary" : "Add a title to the watchlist",
        "description" : "Idempotent: adding a title that is already on the list returns the existing entry rather than failing, because adding something twice is a slip rather than an error.",
        "operationId" : "add",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AddWatchlistItemRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WatchlistItemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles" : {
      "post" : {
        "tags" : [ "catalogue-controller" ],
        "summary" : "Ingest a title from TMDB",
        "description" : "Idempotent: ingesting the same title again refreshes it in place and returns 200 rather than creating a duplicate. Availability is fetched separately, after this returns, so a provider outage cannot fail the ingest.",
        "operationId" : "ingest",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/IngestTitleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TitleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions" : {
      "get" : {
        "tags" : [ "subscription-controller" ],
        "summary" : "What the signed-in user pays for",
        "description" : "monthlyTotal counts active and trial subscriptions only. Cancelled and lapsed rows are kept and returned, because what someone used to pay for is part of the record, but they cost nothing now and including them would overstate the bill.",
        "operationId" : "list_1",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubscriptionListResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "subscription-controller" ],
        "summary" : "Record a subscription",
        "operationId" : "add_1",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSubscriptionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubscriptionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Create an account and start a session",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/auth/refresh" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Rotate the refresh token and issue a new access token",
        "description" : "Reads the HttpOnly refresh cookie. Presenting an already-spent token revokes the entire token family, so a leaked token cannot be used quietly alongside the legitimate session.",
        "operationId" : "refresh",
        "parameters" : [ {
          "name" : "plotted_refresh",
          "in" : "cookie",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "End the session and revoke its refresh-token family",
        "operationId" : "logout",
        "parameters" : [ {
          "name" : "plotted_refresh",
          "in" : "cookie",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "summary" : "Exchange credentials for a session",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        },
        "security" : [ ]
      }
    },
    "/api/v1/watchlist/items/{itemId}" : {
      "delete" : {
        "tags" : [ "watchlist-controller" ],
        "summary" : "Remove a title from the watchlist",
        "operationId" : "remove",
        "parameters" : [ {
          "name" : "itemId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      },
      "patch" : {
        "tags" : [ "watchlist-controller" ],
        "summary" : "Update priority, status or intent for a watchlist entry",
        "description" : "Partial update; omitted fields are unchanged.",
        "operationId" : "update",
        "parameters" : [ {
          "name" : "itemId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateWatchlistItemRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WatchlistItemResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/settings" : {
      "get" : {
        "tags" : [ "user-controller" ],
        "summary" : "Recommendation and budget defaults for the signed-in account",
        "operationId" : "settings",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserSettingsResponse"
                }
              }
            }
          }
        }
      },
      "patch" : {
        "tags" : [ "user-controller" ],
        "summary" : "Update recommendation and budget defaults",
        "description" : "Partial update; omitted fields are unchanged. weeklyViewingMinutesOverride replaces the trailing eight-week estimate that drives completion feasibility and cancellation advice.",
        "operationId" : "updateSettings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateUserSettingsRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserSettingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subscriptions/{subscriptionId}" : {
      "delete" : {
        "tags" : [ "subscription-controller" ],
        "summary" : "Forget a subscription entirely",
        "description" : "Deletes the record. To mark something as no longer paid for while keeping its history, PATCH the status to cancelled instead.",
        "operationId" : "remove_1",
        "parameters" : [ {
          "name" : "subscriptionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      },
      "patch" : {
        "tags" : [ "subscription-controller" ],
        "summary" : "Update a subscription",
        "description" : "Partial update; omitted fields are unchanged.",
        "operationId" : "update_1",
        "parameters" : [ {
          "name" : "subscriptionId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateSubscriptionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SubscriptionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/watchlist" : {
      "get" : {
        "tags" : [ "watchlist-controller" ],
        "summary" : "The signed-in user's watchlist",
        "description" : "Ordered by priority, highest first, then by when each title was added.",
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WatchlistResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/watchlist/coverage" : {
      "get" : {
        "tags" : [ "coverage-controller" ],
        "summary" : "Which service covers the most of the watchlist",
        "description" : "Shares are weighted by priority rather than counted, so one title someone urgently wants outranks several they are lukewarm about. Only outstanding items count: something already watched says nothing about which service to pay for next month. Titles whose availability has never been checked are excluded and reported in unknownTitles, because scoring them as uncovered would penalise every service in proportion to how stale Plotted's own data is.",
        "operationId" : "coverage",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CoverageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me" : {
      "get" : {
        "tags" : [ "user-controller" ],
        "summary" : "The signed-in account",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles/{titleId}" : {
      "get" : {
        "tags" : [ "catalogue-controller" ],
        "summary" : "A single ingested title",
        "operationId" : "byId",
        "parameters" : [ {
          "name" : "titleId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TitleResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles/{titleId}/availability" : {
      "get" : {
        "tags" : [ "availability-controller" ],
        "summary" : "Where a title can be watched",
        "description" : "Always answers, even when the data is old. Staleness is reported rather than hidden: the degraded behaviour Plotted promises is cached availability with a visible timestamp, not a pretence of knowing nothing.",
        "operationId" : "byTitle",
        "parameters" : [ {
          "name" : "titleId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles/search" : {
      "get" : {
        "tags" : [ "catalogue-controller" ],
        "summary" : "Search the ingested catalogue",
        "description" : "Full-text and trigram matching, so a typo still finds the title.",
        "operationId" : "search",
        "parameters" : [ {
          "name" : "query",
          "in" : "query",
          "required" : true,
          "schema" : {
            "maxLength" : 200,
            "minLength" : 1,
            "type" : "string"
          }
        }, {
          "name" : "mediaType",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "MOVIE", "SERIES" ]
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/TitleResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/titles/discover" : {
      "get" : {
        "tags" : [ "catalogue-controller" ],
        "summary" : "Search TMDB for titles Plotted may not have yet",
        "description" : "Degrades to an empty list when TMDB is unreachable rather than failing the request: an empty search box is a better outcome than an error page.",
        "operationId" : "discover",
        "parameters" : [ {
          "name" : "query",
          "in" : "query",
          "required" : true,
          "schema" : {
            "maxLength" : 200,
            "minLength" : 1,
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DiscoverResultResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/providers" : {
      "get" : {
        "tags" : [ "provider-controller" ],
        "summary" : "Services a user could be subscribed to",
        "description" : "Filtered to providers that bill on a recurring basis, so a rental storefront does not appear on a screen asking what someone subscribes to. Carries no pricing: Plotted ships none, because a price it invented would reach the optimiser.",
        "operationId" : "list_2",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProviderListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "AddWatchlistItemRequest" : {
        "required" : [ "titleId" ],
        "type" : "object",
        "properties" : {
          "titleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "priority" : {
            "maximum" : 5,
            "minimum" : 1,
            "type" : "integer",
            "description" : "1 is the highest priority and 5 the lowest. Defaults to 3.",
            "format" : "int32"
          },
          "desiredByDate" : {
            "type" : "string",
            "format" : "date"
          },
          "notes" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "WatchlistItemResponse" : {
        "required" : [ "addedAt", "id", "priority", "status", "titleId" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "titleId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "priority" : {
            "type" : "integer",
            "description" : "1 is the highest priority and 5 the lowest.",
            "format" : "int32"
          },
          "status" : {
            "type" : "string"
          },
          "addedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "desiredByDate" : {
            "type" : "string",
            "format" : "date"
          },
          "notes" : {
            "type" : "string"
          },
          "title" : {
            "$ref" : "#/components/schemas/WatchlistTitleResponse"
          }
        },
        "description" : "A title on the signed-in user's watchlist."
      },
      "WatchlistTitleResponse" : {
        "required" : [ "mediaType", "name" ],
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "mediaType" : {
            "type" : "string"
          },
          "releaseYear" : {
            "type" : "integer",
            "format" : "int32"
          },
          "posterUrl" : {
            "type" : "string"
          },
          "watchMinutes" : {
            "type" : "integer",
            "description" : "Runtime for a film, total episode runtime for a series. Null when unknown.",
            "format" : "int32"
          }
        },
        "description" : "Null when the title has been removed from the catalogue since it was added."
      },
      "IngestTitleRequest" : {
        "required" : [ "mediaType", "tmdbId" ],
        "type" : "object",
        "properties" : {
          "mediaType" : {
            "type" : "string",
            "enum" : [ "MOVIE", "SERIES" ]
          },
          "tmdbId" : {
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32"
          }
        },
        "description" : "Ingest a title from TMDB into the Plotted catalogue."
      },
      "TitleResponse" : {
        "required" : [ "id", "mediaType", "metadataStatus", "name" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "mediaType" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "originalName" : {
            "type" : "string"
          },
          "overview" : {
            "type" : "string"
          },
          "releaseDate" : {
            "type" : "string",
            "format" : "date"
          },
          "posterUrl" : {
            "type" : "string"
          },
          "communityRating" : {
            "type" : "number"
          },
          "watchMinutes" : {
            "type" : "integer",
            "description" : "How long this takes to watch: a film's runtime, or a series' estimated total. Null means Plotted does not know, and a time-constrained recommendation must exclude it.",
            "format" : "int32"
          },
          "episodeCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "metadataStatus" : {
            "type" : "string",
            "description" : "stub, partial, complete or failed. Anything but complete is missing something."
          }
        },
        "description" : "A title Plotted has already ingested."
      },
      "CreateSubscriptionRequest" : {
        "required" : [ "autoRenews", "cannotCancel", "price", "providerId" ],
        "type" : "object",
        "properties" : {
          "providerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "planName" : {
            "maxLength" : 120,
            "minLength" : 0,
            "type" : "string",
            "description" : "The plan as the user knows it, for example 'Standard with ads'. Defaults to 'Standard'."
          },
          "billingPeriod" : {
            "type" : "string",
            "description" : "One of monthly, quarterly, annual.",
            "enum" : [ "monthly", "quarterly", "annual" ]
          },
          "price" : {
            "minimum" : 0.0,
            "exclusiveMinimum" : false,
            "type" : "number"
          },
          "currency" : {
            "maxLength" : 3,
            "minLength" : 3,
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "description" : "One of active, paused, cancelled, trial, lapsed. Defaults to active.",
            "enum" : [ "active", "paused", "cancelled", "trial", "lapsed" ]
          },
          "startedOn" : {
            "type" : "string",
            "format" : "date"
          },
          "renewsOn" : {
            "type" : "string",
            "format" : "date"
          },
          "commitmentEndsOn" : {
            "type" : "string",
            "format" : "date"
          },
          "autoRenews" : {
            "type" : "boolean"
          },
          "cannotCancel" : {
            "type" : "boolean"
          },
          "notes" : {
            "maxLength" : 2000,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "description" : "Records a subscription the user pays for. Price is supplied by the user rather than looked up: Plotted deliberately ships no pricing data, because a figure it invented would flow straight into the cancellation optimiser's objective."
      },
      "SubscriptionResponse" : {
        "required" : [ "autoRenews", "billingPeriod", "cannotCancel", "currency", "id", "monthlyCost", "planName", "price", "providerId", "providerName", "providerSlug", "startedOn", "status" ],
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "providerId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "providerName" : {
            "type" : "string"
          },
          "providerSlug" : {
            "type" : "string"
          },
          "providerLogoUrl" : {
            "type" : "string"
          },
          "planName" : {
            "type" : "string"
          },
          "billingPeriod" : {
            "type" : "string"
          },
          "price" : {
            "type" : "number",
            "description" : "What the user told us they pay, per billing period."
          },
          "monthlyCost" : {
            "type" : "number",
            "description" : "The same figure expressed per month, so plans on different cycles compare."
          },
